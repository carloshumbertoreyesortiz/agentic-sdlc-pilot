# secrets — never commit
.env
.envrc
.env.*
*.pem
*.key

# dependencies & build output
node_modules/
dist/
coverage/
*.log

# GitHub Pages build dir — dashboard is generated here at deploy time, never
# committed (US-051 / R-05). `npm run dashboard` writes _site/DASHBOARD.md too.
_site/

# OS / editor
.DS_Store
.vscode/settings.json

# agent run artifacts & cache
artifacts/run-*
.agent/cache/
